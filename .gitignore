# modelos e checkpoints (pesados — nunca versionar)
models/
*.safetensors
*.gguf
*.bin
*.pt

# ⭐ BEE — corpus e artefatos do pré-treino
# o corpus de treino passa de 12 GB; os shards e os checkpoints NUNCA entram no git.
# O que se versiona é o MANIFEST (procedência + licença) e o resultado dos gates.
# ⚠️ os padrões abaixo usam `dir/**` e não `dir/` de propósito: com `dir/` o git nem desce no
# diretório, e aí as exceções `!...` abaixo não teriam efeito nenhum (armadilha clássica).
bee/corpus/**
bee/tokenizer/**
bee/checkpoints/**
*.jsonl.zst
!bee/corpus/MANIFEST.json
!bee/tokenizer/gate_fertilidade.json
!bee/tokenizer/tokenizer_config.json
!bee/tokenizer/chat_template.jinja

# dados gerados / intermediários (camada COMEIA)
comeia/data/raw/
comeia/data/processed/
*.jsonl
comeia/eval/results/

# ambiente
.venv/
__pycache__/
*.pyc
.env

# harness clonado
lm-evaluation-harness/
artigos para estudos/

models/bee-150m-v3-base/
models/bee-150m-v3-sft/
docs/sft-run.log
docs/lr-*.log
bee/edu/*.jsonl
bee/edu/*.joblib
docs/anotar-edu.log
bee/gate/
docs/gate-*.log
bee/edu/

# corpus PT em volume (dezenas de GB — nao versionar)
corpus_pt/
gate_pt/
comeia/eval/fixtures/

# corpus de 22B reconstruido localmente (41 GB) e logs de corrida
dados_pt_22b/
*.log
bee/bncc/*.pdf

# holdout do Gate 2 — parquet de 526 MB baixado do HF, sempre reproduzivel
_holdout_tmp/
comeia/eval/benchmarks/b2w_bruto.csv
comeia/eval/benchmarks/humaneval_xl_pt_bruto.jsonl
comeia/data/processed/sft_grupo_*.jsonl
comeia/models/
comeia/data/raw/gigaverbo/
comeia/data/processed/gigaverbo_*.jsonl
comeia/data/processed/mix_e4/

# gate das faixas (2026-09-01): pools de 329 MB, checkpoints de sonda e as copias
# de staging que foram para o pod. O que se versiona e' o RESULTADO e os holdouts.
bee/gate_faixas/m_*/
bee/gate_faixas/config.py
bee/gate_faixas/gate_faixas.py

# Gate T1 — amostra multilingue (shards de texto; o MANIFEST e' o que se versiona)
bee/corpus_multi/**
bee/corpus_multi_teste/**
!bee/corpus_multi/MANIFEST.json
!bee/corpus_multi_teste/MANIFEST.json
bee/tok_t1/**
